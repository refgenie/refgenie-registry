# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Generated FHR sidecars. pep/metadata/ is a STAGING folder, not source:
# build/generate_genome_metadata.py re-derives every file in it from
# genomes/**/*.yaml, and the nightly regenerates it before anything reads it.
# Committing them would make every genome PR carry a second file mirroring the
# first, and reviewing a deterministic projection of the YAML is reviewing the
# same facts twice.
# (pep/samples.csv IS still committed: its diff is the go/no-go gate for builds.)
pep/metadata/

# Store build artifacts (run logs, backups, staging maps)
*.log
*.bak-*
.staging_map.tsv

# Recipe-build artifacts (regenerated each run by build/run_builds.sh)
build/Snakefile
build/inputs/
build/.refgenie_build*
.snakemake/
